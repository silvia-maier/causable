          <div class="js-contact-btn cursor-pointer">
            <h3 class="text-2xl pb-3">
              Wie kann ich Sie unterstützen?
            </h3>
            <p class="text-lg">
              Ich bin gespannt auf Ihre Herausforderung!
            </p>
            <p class="text-secondary3 underline pt-3">
              Kontakt aufnehmen
            </p>
          </div>
          <div class="js-contact-form hidden text-left text-xl font-sans">
            {% include 'includes/_contact-form.liquid' checked: 'sparring' %}
          </div>
        </div>
      </section>

      <section class="container mx-auto px-4 max-w-3xl pb-28">
        <picture class="block mt-12">
          <img src="/assets/Cedac_Silvia Maier_RAW0044_web.jpeg"
            class="rounded-full mx-auto max-w-[70%] xl:max-w-[400px]">
          <figcaption class="text-center text-sm pt-4 text-gray-500">
            Foto: Cedac © Claudia Link
          </figcaption>
        </picture>
      </section>

    </main>

    {% include 'templates/_footer.liquid' %}

